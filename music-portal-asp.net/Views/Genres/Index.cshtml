@model IEnumerable<MusicPortal.BusinessLogic.DTO.GenreDTO>
@{
    ViewData["Title"] = "Жанры";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Жанры</h2>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" asp-controller="Genres" asp-action="Create">Добавить жанр</a>
    }
</div>

<table class="table table-striped bg-white">
    <thead>
        <tr>
            <th>Название</th>
            @if (User.IsInRole("Admin"))
            {
                <th class="text-end">Действия</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var genre in Model)
        {
            <tr>
                <td>@genre.Name</td>
                @if (User.IsInRole("Admin"))
                {
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Genres" asp-action="Edit" asp-route-id="@genre.Id">Изменить</a>
                        <form asp-controller="Genres" asp-action="Delete" asp-route-id="@genre.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Удалить жанр? Он будет отвязан от всех песен.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@model SongUploadViewModel
@{
    ViewData["Title"] = "Загрузить песню";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Загрузить песню</h2>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Artists" asp-action="Create">+ Новый исполнитель</a>
        </div>
        <form asp-controller="Songs" asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ArtistId" class="form-label"></label>
                <select asp-for="ArtistId" asp-items="ViewBag.Artists" class="form-select">
                    <option value="">— выберите исполнителя —</option>
                </select>
                <span asp-validation-for="ArtistId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="File" class="form-label"></label>
                <input asp-for="File" type="file" class="form-control" accept=".mp3,.wav,.flac,.ogg" />
                <span asp-validation-for="File" class="text-danger"></span>
                <div class="form-text">Форматы: mp3, wav, flac, ogg. Максимум 50 МБ.</div>
            </div>

            <div class="mb-3">
                <label asp-for="GenreIds" class="form-label"></label>
                <select asp-for="GenreIds" asp-items="ViewBag.Genres" class="form-select" multiple size="6"></select>
                <div class="form-text">Ctrl + клик чтобы выбрать несколько.</div>
                <span asp-validation-for="GenreIds" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Загрузить</button>
        </form>
    </div>
</div>

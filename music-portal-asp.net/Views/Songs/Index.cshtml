@model PagedResult<SongDTO>

@{
    ViewData["Title"] = "Каталог песен";
    var genres = ViewBag.Genres as IEnumerable<GenreDTO>;
    var artists = ViewBag.Artists as IEnumerable<ArtistDTOBrief>;
    int? selectedGenreId = ViewBag.SelectedGenreId as int?;
    int? selectedArtistId = ViewBag.SelectedArtistId as int?;
    string? currentSort = ViewBag.SortBy as string;
    bool currentDesc = ViewBag.Desc ?? true;

    var filterRouteValues = new Dictionary<string, string?>
    {
        ["genreId"] = selectedGenreId?.ToString(),
        ["artistId"] = selectedArtistId?.ToString()
    };
    var sortRouteValues = new Dictionary<string, string?>(filterRouteValues);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🎵 Каталог песен</h2>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-primary">Загрузить песню</a>
        }
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Жанр:</label>
                    <select name="genreId" class="form-select" onchange="this.form.submit()">
                        <option value="">Все жанры</option>
                        @if (genres != null)
                        {
                            foreach (var genre in genres)
                            {
                                <option value="@genre.Id" selected="@(genre.Id == selectedGenreId)">@genre.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Исполнитель:</label>
                    <select name="artistId" class="form-select" onchange="this.form.submit()">
                        <option value="">Все исполнители</option>
                        @if (artists != null)
                        {
                            foreach (var artist in artists)
                            {
                                <option value="@artist.Id" selected="@(artist.Id == selectedArtistId)">@artist.Name</option>
                            }
                        }
                    </select>
                </div>

                <input type="hidden" name="sortBy" value="@currentSort" />
                <input type="hidden" name="desc" value="@(currentDesc ? "true" : "false")" />

                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-secondary w-100">Применить фильтр</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Items != null && Model.Items.Any())
    {
        <div class="d-flex gap-4 mb-3 px-2">
            <sort-link sort-key="title" current-sort="@currentSort" current-desc="@currentDesc"
                       action="Index" controller="Songs" route-values="@sortRouteValues">
                По названию
            </sort-link>
            <sort-link sort-key="rating" current-sort="@currentSort" current-desc="@currentDesc"
                       action="Index" controller="Songs" route-values="@sortRouteValues">
                По рейтингу
            </sort-link>
            <sort-link sort-key="plays" current-sort="@currentSort" current-desc="@currentDesc"
                       action="Index" controller="Songs" route-values="@sortRouteValues">
                По прослушиваниям
            </sort-link>
            <sort-link sort-key="date" current-sort="@currentSort" current-desc="@currentDesc"
                       action="Index" controller="Songs" route-values="@sortRouteValues">
                По дате
            </sort-link>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var song in Model.Items)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title text-truncate">@song.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@song.ArtistName</h6>
                            <p class="card-text mb-1">
                                <small class="text-muted">Рейтинг:</small>
                                <span class="badge bg-warning text-dark">⭐ @song.Rating.ToString("F1")</span>
                            </p>
                            <p class="card-text mb-3">
                                <small class="text-muted">Прослушиваний:</small> 🎧 @song.PlayCount
                            </p>
                            <audio controls class="w-100 mb-3">
                                <source src="@Url.Action("Play", "Songs", new { id = song.Id })" type="audio/mpeg">
                            </audio>
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-action="Details" asp-route-id="@song.Id" class="btn btn-sm btn-outline-primary">Подробнее</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@song.Id" class="btn btn-sm btn-outline-secondary">Редактировать</a>
                                        <form asp-action="Delete" asp-route-id="@song.Id" method="post" onsubmit="return confirm('Удалить песню?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <pagination current-page="@Model.Page" total-pages="@Model.TotalPages"
                    action="Index" controller="Songs"
                    route-values="@sortRouteValues">
        </pagination>
    }
    else
    {
        <div class="text-center py-5">
            <h4 class="text-muted">Песни не найдены</h4>
            <p>Попробуйте изменить параметры фильтрации или загрузить новую песню.</p>
        </div>
    }
</div>

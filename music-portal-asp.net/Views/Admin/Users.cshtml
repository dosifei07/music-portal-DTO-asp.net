@model PagedResult<UserDTO>
@{
    ViewData["Title"] = "Пользователи";
}

<h2 class="mb-4">Пользователи</h2>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Имя</th>
            <th>Email</th>
            <th>Роли</th>
            <th>Одобрен</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Items)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.Email</td>
                <td>
                    @foreach (var role in user.Roles)
                    {
                        <span class="badge bg-secondary genre-badge">@role.Name</span>
                    }
                </td>
                <td>
                    @if (user.IsApproved)
                    {
                        <span class="badge bg-success">Да</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Нет</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Admin" asp-action="EditUser" asp-route-id="@user.Id">Изменить</a>
                    <form asp-controller="Admin" asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Удалить пользователя? Его исполнительский профиль и песни будут сохранены.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<pagination current-page="Model.Page"
            total-pages="Model.TotalPages"
            action="Users"
            controller="Admin">
</pagination>